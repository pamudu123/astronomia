# Copy to agent/.env and fill in. agent/.env is ignored by git; never commit a real key.
OPENAI_API_KEY=

# Optional. Defaults shown.
# ASTRONOMIA_AGENT_MODEL=openai:gpt-6-luna
# ASTRONOMIA_AGENT_REASONING_EFFORT=low
# Minutes without a message before a chat is deleted from memory. The privacy notice states it.
# ASTRONOMIA_AGENT_CONVERSATION_IDLE_MINUTES=30
# ASTRONOMIA_AGENT_BACKEND_URL=http://localhost:8000
# ASTRONOMIA_AGENT_BACKEND_ACCESS_KEY=
# When set, the frontend must send the same value as AGENT_ACCESS_KEY.
# ASTRONOMIA_AGENT_ACCESS_KEY=
# Chat limits (docs/21): the backend's ASTRONOMIA_CHAT_KEY. Empty: no limits (local runs).
# ASTRONOMIA_AGENT_CHAT_KEY=
# The model's prices, US dollars per million tokens, to measure each answer's cost.
# ASTRONOMIA_AGENT_PRICE_INPUT=0.25
# ASTRONOMIA_AGENT_PRICE_CACHED_INPUT=0.025
# ASTRONOMIA_AGENT_PRICE_OUTPUT=2.0
