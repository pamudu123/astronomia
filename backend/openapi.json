    "/v1/places": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Find Places",
        "operationId": "find_places_v1_places_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "description": "Place name, any script",
              "title": "Q"
            },
            "description": "Place name, any script"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
