{
  "name": "astronomia-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "predev": "npm run copy-assets",
    "dev": "next dev",
    "prebuild": "npm run copy-assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:types": "openapi-typescript ../backend/openapi.json -o lib/api-types.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
